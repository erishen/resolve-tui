# resolve-tui 配置示例：复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）
# 所有变量均可被同名环境变量覆盖。

# OpenAI / OpenAI 兼容 API 的鉴权 key（bearer token）
OPENAI_API_KEY=

# API base url，不含末尾 /responses（兼容 vLLM、LiteLLM、本地网关等）
OPENAI_API_BASE=https://api.openai.com/v1

# 模型名（传给 /responses 的 model 字段）
HARNESS_MODEL=gpt-4o-mini

# agent 循环最大迭代次数，防止模型死循环
HARNESS_MAX_ITERATIONS=16

# 是否启用沙箱（true/false）。关闭后命令在本机无隔离执行。
HARNESS_SANDBOX=true

# 是否允许沙箱内访问网络（true/false）。默认禁网。
HARNESS_ALLOW_NETWORK=false

# 允许写入的目录白名单（逗号分隔）。为空时默认「当前工作目录 + 系统临时目录」。
HARNESS_SANDBOX_ROOTS=

# 是否用 Responses API 的 previous_response_id 做有状态续接（true/false）。
# 部分网关（如 Agnes）不持久化响应，置 false（默认）改为回灌 function_call 项。
HARNESS_STATEFUL=false

# 调试开关：强制模型至少调用一个工具（tool_choice=required）。
HARNESS_FORCE_TOOLS=false

# 工具审批模式（true/false）。仅交互式 TUI 生效：每次工具调用前暂停，
# 显示命令内容并等待 y 允许 / n 拒绝。CLI 模式忽略（始终执行）。
HARNESS_APPROVE_TOOLS=false

# 累计 token 预算上限（整数）。>0 时累计消耗达到上限即终止循环；0 不限。
HARNESS_MAX_TOKENS=0

# 会话归档目录（/create /save /apply / --resume 使用）。默认当前目录下 .resolve-tui-sessions/
HARNESS_SESSIONS_DIR=

# 技能目录（指向 resolve-skills 的 skills/ 子目录）。
# 本仓库已通过 git submodule 引入 resolve-skills，默认指向 ./resolve-skills/skills。
# 如需使用外部技能仓库，可修改为绝对路径。
HARNESS_SKILLS_DIR=./resolve-skills/skills

# PSE 三角色人格目录（私有，必填）。
# 重要：resolve-skills submodule bump 到 2b6f527+ 后 souls/ 不再被跟踪会消失，
# 因此必须指向 submodule 之外的稳定目录（下方为示例，请改成你本机 standalone 的路径）。
# TUI 的 Rust 加载器（src/skills.rs souls_dir）实际读取 HARNESS_SOULS_DIR。
# HARNESS_SOULS_DIR=/path/to/your/resolve-skills/souls
